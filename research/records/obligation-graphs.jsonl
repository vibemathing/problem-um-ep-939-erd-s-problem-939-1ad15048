{"attempt_id": "attempt:um-ep-939-erd-s-problem-939-1ad15048-source-fidelity-01", "created_at": "2026-09-06T08:00:00Z", "graph_id": "graph:um-ep-939-erd-s-problem-939-1ad15048-v1", "obligations": [{"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": ["obligation:um-ep-939-erd-s-problem-939-1ad15048-statement-fidelity"], "kind": "root_claim", "obligation_id": "obligation:um-ep-939-erd-s-problem-939-1ad15048-root", "source_refs": ["https://www.unsolvedmath.com/problems/EP-939"], "statement": {"formal_declaration": null, "language": "en", "text": "Let $r\\geq 2$. An $r$-powerful number $n$ is one such that if $p\\mid n$ then $p^r\\mid n$. If $r\\geq 4$ then can the sum of $r-2$ coprime $r$-powerful numbers ever be itself $r$-powerful? Are there at most finitely many such solutions? Are there infinitely many triples of coprime $3$-powerful numbers $a,b,c$ such that $a+b=c$?"}, "statement_sha256": "f62d0f1e7b6860d194a20e56b794fc4694ff2bcdcc456aa07984077f7f0d044c"}, {"acceptance": {"allowed_candidate_kinds": ["proof"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": [], "kind": "definition", "obligation_id": "obligation:um-ep-939-erd-s-problem-939-1ad15048-statement-fidelity", "source_refs": ["https://www.unsolvedmath.com/problems/EP-939"], "statement": {"formal_declaration": null, "language": "en", "text": "Verify against the cited source that the frozen statement is complete, current, untruncated, attribution-correct, and unambiguous enough for mathematical research; record any definition or quantifier gap without silently editing the contract."}, "statement_sha256": "65f0b3d574bd6d837403149dab6434c0f571709f7eb5bb066c7e8774bad13f34"}], "problem_contract_sha256": "8f5753b2ca4c28231975ab445d6292cd664d3aaffb57530b98c1aa3ae646c982", "problem_id": "problem:um-ep-939-erd-s-problem-939-1ad15048", "root_ob